# Copy to .env. That file is not committed.
# Never commit real passwords.

# --- Shop website ---
E2E_BASE_URL=https://pwa-kit.mobify-storefront.com
E2E_SITE_ALIAS=global
E2E_LOCALE=en-US

# --- Shop API ---
# Public demo values (safe to commit). Change to hit a different shop.
SFCC_SHORT_CODE=8o7m175y
SFCC_ORG_ID=f_ecom_zzrf_001
SFCC_CLIENT_ID=c9c45bfd-0ed3-4aa2-9971-40f88962b836
SFCC_SITE_ID=RefArchGlobal

# --- Test login (secret) ---
# For signed-in tests. Leave blank for guest only.
E2E_ACCOUNT_EMAIL=
E2E_ACCOUNT_PASSWORD=

# --- Order Management journeys ---
# Orders the account above owns, already in the state each journey needs. Seeded
# rather than placed by the test: OMS ingestion is not retroactive and cannot
# advance an order on demand. Leave blank and those journeys skip.
# Needs an OMS shipment carrying a carrier tracking URL (order must be fulfilled).
E2E_OMS_TRACKING_ORDER_NO=
# Needs nothing allocated yet, so the whole order is still cancellable.
E2E_OMS_CANCEL_ORDER_NO=
# Needs a line with a returnable quantity (order must have shipped).
E2E_OMS_RETURN_ORDER_NO=

EINSTEIN_HOST=https://api.cquotient.com
EINSTEIN_ID=1ea06c6e-c936-4324-bcf0-fada93f83bb1
EINSTEIN_SITE_ID=aaij-MobileFirst
DATACLOUD_APP_SOURCE_ID=7ae070a6-f4ec-4def-a383-d9cacc3f20a1
DATACLOUD_TENANT_ID=g82wgnrvm-ywk9dggrrw8mtggy.pc-rnd