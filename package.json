{
  "name": "jh-salesforce-automation",
  "version": "1.0.0",
  "description": "Playwright E2E + API tests for the Salesforce PWA Kit Retail React App storefront",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:cross-browser": "playwright test --project=e2e-firefox --project=e2e-webkit --project=mobile-chrome --project=mobile-safari",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "docker run --rm -v $(pwd):/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test --project=visual --update-snapshots",
    "test:performance": "playwright test --project=performance",
    "test:security": "playwright test --project=security",
    "test:quality": "playwright test --project=a11y --project=visual --project=performance --project=security",
    "test:canary": "playwright test --project=canary --grep @live",
    "test:headed": "playwright test --project=e2e --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "gen:api:fetch": "node scripts/fetch-api-specs.mjs",
    "gen:api": "node scripts/generate-api-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:title-parity": "node scripts/check-title-parity.mjs",
    "check:target": "node --experimental-strip-types --no-warnings scripts/check-target.mjs",
    "test:targets": "node --experimental-strip-types --no-warnings support/targets.test.ts",
    "test:contracts": "node --experimental-strip-types --no-warnings api/support/schemas.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "zod": "^4.4.3"
  }
}
