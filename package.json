{
  "name": "jh-salesforce-automation",
  "version": "1.0.0",
  "description": "Playwright E2E + API tests for the Salesforce PWA Kit Retail React App storefront",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=e2e-chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "gen:api:fetch": "node scripts/fetch-api-specs.mjs",
    "gen:api": "node scripts/generate-api-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
